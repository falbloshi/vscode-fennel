{
	"name": "vscode-fennel",
	"displayName": "Fennel",
	"description": "Fennel language support for Visual Studio Code",
	"publisher": "Faris Akherdad",
	"version": "0.3.3",
	"repository": "https://github.com/falbloshi/vscode-fennel",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Programming Languages"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onLanguage:fennel"
	],
	"contributes": {
		"languages": [
			{
				"id": "fennel",
				"aliases": [
					"Fennel",
					"fnl"
				],
				"extensions": [
					".fnl",
					".fennel"
				],
				"configuration": "./fennel-configuration.json",
				"icon": {
					"light": "./images/file-icon-light.svg",
					"dark": "./images/file-icon-dark.svg"
				}
			}
		],
		"grammars": [
			{
				"language": "fennel",
				"scopeName": "source.fnl",
				"path": "./syntaxes/fnl.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "fennel.startREPL",
				"title": "Fennel: Start REPL"
			},
			{
				"command": "fennel.eval",
				"title": "Fennel: Evaluate expression"
			},
			{
				"command": "fennel.evalFile",
				"title": "Fennel: Evaluate file"
			},
			{
				"command": "fennel.formatFile",
				"title": "Fennel: Format file"
			},
			{
				"command": "fennel.selectExecutable",
				"title": "Fennel: Select Executable Type (fennel / fenneljit)"
			}
		],
		"keybindings": [
			{
				"command": "fennel.eval",
				"key": "alt+e"
			},
			{
				"command": "fennel.evalFile",
				"key": "alt+l"
			}
		],
		"configuration": {
			"title": "Fennel Configuration",
			"properties": {
				"fennel.executableType": {
					"type": "string",
					"enum": [
						"fennel",
						"fenneljit"
					],
					"default": "fennel",
					"description": "Choose whether to use the standard fennel binary or fenneljit."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint . --ext .ts,.tsx",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.90.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "8.0.0",
		"eslint": "^9.0.0",
		"typescript": "^5.8.0"
	}
}

