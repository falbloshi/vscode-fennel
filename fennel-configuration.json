{
  "comments": {
    "lineComment": ";"
  },
  "wordPattern": "[a-zA-Z0-9_\\|&<>~?:!-]+",
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\([a-zA-Z0-9_\\|&<>~?:!-]+\\s+.*|\\{\\s*|\\[\\s*)$",
    "decreaseIndentPattern": "^\\s*([\\)\\]\\}])$"
  }
}