{
  "comments": {
    "lineComment": ";"
  },
  "wordPattern": "[:&|-<>-~a-zA-Z_0-9]+",
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
  "increaseIndentPattern": "^.*[(\\[{]\\s*$",
  "decreaseIndentPattern": "^\\s*[)\\]}]"
  }
  
}