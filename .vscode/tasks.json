{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "pattern": {
          "regexp": "^([^(]+)\\((\\d+),(\\d+)\\): (error|warning) TS(\\d+): (.*)$",
          "file": 1,
          "location": 2,
          "endLine": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^([^(]+)\\((\\d+),(\\d+)\\): (error|warning) TS(\\d+): (.*)$",
          "file": 1,
          "location": 2,
          "endLine": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    }
  ]
}